<div class="max-w-2xl mx-auto space-y-6">
  <div class="transit-box p-6 sm:p-8">
    <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4 border-b-bar border-rule pb-5">
      <div>
        <span class="text-xs font-bold text-accent uppercase tracking-wider block">Konfirmasi Pembayaran</span>
        <h1 class="text-xl font-extrabold text-ink uppercase tracking-tight mt-1">
          <%= activeMethod === 'qris' ? 'Pembayaran Instan QRIS' : 'Unggah Bukti Transfer Bank' %>
        </h1>
        <p class="text-xs text-muted mt-1">
          Kode Booking: <strong class="font-mono text-ink"><%= booking.kode_booking %></strong>
          &bull; Total:
          <strong class="text-ink num">
            <%= new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(booking.total) %>
          </strong>
        </p>
      </div>

      <% if (qrisEnabled && qrisEnvironment === 'sandbox' && activeMethod === 'qris') { %>
        <span class="inline-block px-2.5 py-1 border-bar border-ink bg-accent-2 text-ink text-[10px] font-extrabold uppercase tracking-wider self-start">
          Midtrans Sandbox
        </span>
      <% } %>
    </div>

    <!-- Navigasi Metode Pembayaran: Wayfind Square Cells -->
    <% if (qrisEnabled) { %>
      <div class="mt-5 grid grid-cols-2 border-bar border-rule bg-paper text-xs font-bold uppercase">
        <a href="/pesanan/<%= booking.kode_booking %>/bayar?metode=qris"
          class="px-4 py-2.5 text-center border-r-hair border-rule <%= activeMethod === 'qris' ? 'bg-ink text-paper' : 'text-ink hover:bg-paper-2' %>">
          QRIS Instan (Otomatis)
        </a>
        <a href="/pesanan/<%= booking.kode_booking %>/bayar?metode=transfer"
          class="px-4 py-2.5 text-center <%= activeMethod === 'transfer' ? 'bg-ink text-paper' : 'text-ink hover:bg-paper-2' %>">
          Transfer Bank Manual
        </a>
      </div>
    <% } %>

    <% if (activeMethod === 'qris' && qrisEnabled) { %>
      <!-- Panel Pembayaran QRIS -->
      <div class="mt-6 space-y-5">
        <% if (!gatewayPayment) { %>
          <div class="p-5 border-bar border-rule bg-paper-3 space-y-3">
            <div class="flex items-center justify-between gap-2">
              <span class="text-xs font-extrabold uppercase text-ink">Scan & Lunas Otomatis via QRIS</span>
              <span class="px-2 py-0.5 border-hair border-rule bg-paper text-[10px] font-bold uppercase text-accent">
                Tanpa Verifikasi Manual
              </span>
            </div>
            <p class="text-xs text-muted leading-relaxed">
              Bayar menggunakan aplikasi e-wallet atau mobile banking pendukung QRIS (GoPay, OVO, DANA, ShopeePay, BCA Mobile, Livin&apos;, BRImo, dll).
              Setelah pembayaran berhasil, status tiket otomatis berubah menjadi <strong class="text-ink">LUNAS</strong>.
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1 text-xs">
              <div class="p-3 border-hair border-rule bg-paper">
                <span class="text-[10px] font-bold uppercase text-muted block">Total Tagihan</span>
                <span class="text-base font-extrabold text-ink num">
                  <%= new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(booking.total) %>
                </span>
              </div>
              <div class="p-3 border-hair border-rule bg-paper">
                <span class="text-[10px] font-bold uppercase text-muted block">Batas Waktu Hold Kursi</span>
                <span class="text-xs font-bold text-ink font-mono">
                  <%= booking.jatuh_tempo ? new Date(booking.jatuh_tempo).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) + ' WIB' : '-' %>
                </span>
              </div>
            </div>
          </div>

          <form action="/pesanan/<%= booking.kode_booking %>/bayar/qris" method="POST" data-single-submit="Membuat Kode QRIS..." class="space-y-4">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 border-t-hair border-rule">
              <a href="/pesanan/<%= booking.kode_booking %>" class="transit-btn transit-btn-ink text-xs py-2.5 px-4">
                &larr; Detail Pesanan
              </a>
              <button type="submit" class="transit-btn transit-btn-cobalt text-xs py-2.5 px-6">
                Buat Kode QRIS Sekarang
              </button>
            </div>
          </form>
        <% } else { %>
          <!-- Tampilan QRIS Aktif -->
          <div id="qris-live-panel"
            data-status-url="/pesanan/<%= booking.kode_booking %>/bayar/qris/status"
            data-invoice-url="/pesanan/<%= booking.kode_booking %>"
            data-expires-at="<%= gatewayPayment.expiresAt ? new Date(gatewayPayment.expiresAt).toISOString() : '' %>"
            class="space-y-5">

            <div class="p-5 border-bar border-rule bg-paper-3 text-center space-y-4">
              <div class="flex items-center justify-between text-xs border-b-hair border-rule pb-3">
                <span class="font-extrabold uppercase text-ink">Scan Kode QRIS</span>
                <span class="font-mono font-bold text-accent">
                  Sisa Waktu: <strong id="qris-countdown" class="text-ink">--:--</strong>
                </span>
              </div>

              <!-- Pelat Putih Kontras Tinggi agar QR selalu mudah di-scan di Mode Terang maupun Gelap -->
              <div class="flex justify-center py-2">
                <div class="inline-block bg-white p-4 border-bar border-rule">
                  <% if (gatewayPayment.qrSvg) { %>
                    <div class="w-60 h-60 flex items-center justify-center">
                      <%- gatewayPayment.qrSvg %>
                    </div>
                  <% } else if (gatewayPayment.qrUrl) { %>
                    <img src="<%= gatewayPayment.qrUrl %>" alt="Kode QRIS Pembayaran" class="w-60 h-60 object-contain">
                  <% } %>
                </div>
              </div>

              <div class="space-y-1">
                <p class="text-xs font-extrabold text-ink num">
                  Total Bayar: <%= new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(gatewayPayment.amount) %>
                </p>
                <p class="text-[11px] font-mono text-muted">
                  Ref Gateway: <strong class="text-ink"><%= gatewayPayment.gatewayOrderId %></strong>
                </p>
                <p id="qris-live-status" class="text-[11px] font-bold text-accent pt-1">
                  Menunggu pembayaran... Status disinkronkan otomatis setiap 5 detik.
                </p>
              </div>
            </div>

            <% if (gatewayPayment.environment === 'sandbox' && gatewayPayment.qrUrl) { %>
              <div class="p-4 border-bar border-rule bg-paper text-xs space-y-2">
                <div class="flex items-center justify-between gap-2">
                  <span class="font-extrabold uppercase text-ink">Panduan Uji Midtrans Sandbox</span>
                  <a href="https://simulator.sandbox.midtrans.com/qris/index" target="_blank" rel="noopener noreferrer"
                    class="text-accent font-bold underline">
                    Buka Simulator QRIS &rarr;
                  </a>
                </div>
                <p class="text-[11px] text-muted">
                  Salin URL gambar QR di bawah ini lalu tempel di Midtrans QRIS Simulator untuk menyimulasikan pembayaran sukses, kemudian klik <strong class="text-ink">Cek Status Pembayaran</strong>.
                </p>
                <div class="flex gap-2">
                  <input id="qris-simulator-url" type="text" readonly value="<%= gatewayPayment.qrUrl %>"
                    class="flex-1 border-hair border-rule bg-paper-3 px-2.5 py-1.5 text-[11px] font-mono text-ink">
                  <button type="button" id="copy-qris-url-btn" class="transit-btn transit-btn-ink text-[11px] py-1.5 px-3">
                    Salin URL QR
                  </button>
                </div>
              </div>
            <% } %>

            <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 border-t-hair border-rule">
              <div class="flex flex-wrap gap-2">
                <a href="/pesanan/<%= booking.kode_booking %>" class="transit-btn transit-btn-ink text-xs py-2.5 px-4">
                  &larr; Detail Pesanan
                </a>
                <form action="/pesanan/<%= booking.kode_booking %>/bayar/qris/batal" method="POST" data-single-submit="Membatalkan QRIS...">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="next_metode" value="transfer">
                  <button type="submit" class="transit-btn transit-btn-ink text-xs py-2.5 px-4">
                    Ganti ke Transfer Manual
                  </button>
                </form>
              </div>

              <form action="/pesanan/<%= booking.kode_booking %>/bayar/qris/cek" method="POST" data-single-submit="Memeriksa Status...">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="w-full sm:w-auto transit-btn transit-btn-cobalt text-xs py-2.5 px-5">
                  Cek Status Pembayaran
                </button>
              </form>
            </div>
          </div>
        <% } %>
      </div>
    <% } else { %>
      <!-- Panel Transfer Bank Manual (Alur Eksisting Tetap Utuh) -->
      <% if (gatewayPayment) { %>
        <div class="mt-6 p-4 border-bar border-ink bg-accent-2 text-ink text-xs space-y-3">
          <p class="font-bold">
            Pesanan ini saat ini memiliki kode QRIS yang masih aktif (<span class="font-mono"><%= gatewayPayment.gatewayOrderId %></span>).
            Batalkan QRIS terlebih dahulu jika ingin beralih ke Transfer Bank Manual.
          </p>
          <div class="flex flex-wrap gap-2">
            <a href="/pesanan/<%= booking.kode_booking %>/bayar?metode=qris" class="transit-btn transit-btn-cobalt text-xs py-2 px-4">
              Kembali ke Kode QRIS
            </a>
            <form action="/pesanan/<%= booking.kode_booking %>/bayar/qris/batal" method="POST">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="next_metode" value="transfer">
              <button type="submit" class="transit-btn transit-btn-ink text-xs py-2 px-4">
                Batalkan QRIS &amp; Pakai Transfer Manual
              </button>
            </form>
          </div>
        </div>
      <% } else { %>
        <form action="/pesanan/<%= booking.kode_booking %>/bayar?_csrf=<%= csrfToken %>" method="POST"
          enctype="multipart/form-data" class="mt-6 space-y-5">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div>
            <label for="referensi" class="block text-xs font-bold uppercase text-ink mb-1.5">Nomor Referensi / No. Transaksi Bank *</label>
            <input type="text" id="referensi" name="referensi" required
              class="w-full border-bar border-rule bg-paper px-3.5 py-2 text-xs font-bold text-ink focus:outline-none focus:border-accent"
              placeholder="Contoh: 2026103112345678">
          </div>

          <div>
            <label for="no_rek_pengirim" class="block text-xs font-bold uppercase text-ink mb-1.5">Nomor Rekening Pengirim *</label>
            <input type="text" id="no_rek_pengirim" name="no_rek_pengirim" required
              class="w-full border-bar border-rule bg-paper px-3.5 py-2 text-xs font-bold text-ink focus:outline-none focus:border-accent"
              placeholder="Contoh: BCA 1234567890 a.n Anda">
          </div>

          <div>
            <label for="bukti" class="block text-xs font-bold uppercase text-ink mb-1.5">Berkas Foto Resi Transfer *</label>
            <div
              class="mt-1 flex justify-center px-6 pt-5 pb-6 border-bar border-rule border-dashed bg-paper-3 hover:border-accent transition-colors">
              <div class="space-y-2 text-center">
                <div class="flex text-xs text-ink justify-center font-bold">
                  <label for="bukti" class="cursor-pointer transit-btn transit-btn-ink py-1.5 px-3">
                    <span>Pilih Berkas Resi</span>
                    <input id="bukti" name="bukti" type="file" accept="image/jpeg,image/png,image/webp" required
                      class="sr-only">
                  </label>
                </div>
                <p class="text-[11px] text-muted">Format didukung: JPG, PNG, atau WebP (Maksimal 3MB)</p>
              </div>
            </div>
            <p id="file-chosen" class="mt-2 text-xs font-bold text-accent"></p>
          </div>

          <div class="pt-4 flex items-center justify-between gap-4 border-t-hair border-rule">
            <a href="/pesanan/<%= booking.kode_booking %>" class="transit-btn transit-btn-ink text-xs py-2.5 px-4">
              &larr; Detail Pesanan
            </a>
            <button type="submit" class="transit-btn transit-btn-cobalt text-xs py-2.5 px-6">
              Kirim Bukti Pembayaran
            </button>
          </div>
        </form>
      <% } %>
    <% } %>
  </div>
</div>

<script src="/js/qris-payment.js"></script>
<script>
  const fileInput = document.getElementById('bukti');
  const fileChosen = document.getElementById('file-chosen');
  if (fileInput && fileChosen) {
    fileInput.addEventListener('change', () => {
      if (fileInput.files.length > 0) {
        fileChosen.textContent = 'Berkas dipilih: ' + fileInput.files[0].name + ' (' + Math.round(fileInput.files[0].size / 1024) + ' KB)';
      }
    });
  }
</script>
